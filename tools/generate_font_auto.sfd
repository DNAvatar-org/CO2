# FontForge script généré automatiquement - Version automatique
# File: generate_font_auto.sfd
# Pour créer la police: fontforge -script scripts/generate_font_auto.sfd

# Créer une nouvelle police
New()

# Définir les métadonnées
SetFontNames("CO2CustomIcons", "CO2 Custom Icons", "Regular", "Regular", "DNAvatar.org", "2025")
SetTTFName(0x409, 1, "CO2 Custom Icons")
SetTTFName(0x409, 2, "Regular")
SetTTFName(0x409, 4, "CO2 Custom Icons Regular")
SetTTFName(0x409, 6, "CO2CustomIcons-Regular")

# Liste des polices système à essayer
sourceFonts = {
    "/System/Library/Fonts/Apple Color Emoji.ttc",
    "/System/Library/Fonts/Supplemental/Apple Color Emoji.ttc",
    "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",
    "/usr/share/fonts/truetype/noto/Noto Emoji.ttf"
}

# Fonction pour trouver une police source
function FindSourceFont()
    local font
    local i, path
    for i, path in ipairs(sourceFonts) do
        font = Open(path)
        if font then
            return font, path
        end
    end
    return nil, nil
end

# Ouvrir une police source
sourceFont, sourcePath = FindSourceFont()
if not sourceFont then
    Print("⚠️  Aucune police système avec emojis trouvée.")
    Print("   Les glyphes seront vides - vous devrez les remplir manuellement.")
else
    Print("✅ Police source trouvée: " .. sourcePath)
end

# Créer les glyphes et copier depuis la source

# Emoji: 🏐 -> U+E000 (alb)
Select(57344)
CreateGlyph()
GlyphInfo("Unicode", 57344)
GlyphInfo("Name", "alb")

# Essayer de copier depuis la police source
if sourceFont then
    Select(127952)
    if GlyphInfo("Selected") then
        Copy()
        Select(57344)
        Paste()
        Print("✅ Copié 🏐 (alb) depuis la source")
    else
        Print("⚠️  Glyphe 1F3D0 non trouvé dans la source pour 🏐")
    end
end

