/* File: logo-nonA-stix.css.optional - STIX Two Text (Ā) — optionnel
   Desc: @font-face italic uniquement. Renommer en .css et utiliser .logo-nonA-stix si tu préfères STIX.
   Version 1.0.0 | Copyright 2025 DNAvatar.org - Arnaud Maignan */

@font-face {
    font-family: 'STIX Two Text';
    src: url('STIXTwoText-Italic-VariableFont_wght.ttf') format('truetype');
    font-weight: 100 900;
    font-style: italic;
}

.logo-nonA-stix {
    display: inline-block;
    font-size: 1em;
    line-height: 1;
    vertical-align: baseline;
    flex-shrink: 0;
}
.logo-nonA-stix .char {
    font-family: 'STIX Two Text', serif;
    font-weight: 100;
    font-style: italic;
    color: inherit;
}
