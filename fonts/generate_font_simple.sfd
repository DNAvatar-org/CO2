# FontForge script - Version simple
# Pour créer la police: fontforge -script generate_font_simple.sfd

New()

SetFontNames("CO2CustomIcons", "CO2 Custom Icons", "Regular", "Regular", "DNAvatar.org", "2025")
SetTTFName(0x409, 1, "CO2 Custom Icons")
SetTTFName(0x409, 2, "Regular")
SetTTFName(0x409, 4, "CO2 Custom Icons Regular")
SetTTFName(0x409, 6, "CO2CustomIcons-Regular")

# Créer les glyphes pour chaque emoji dans la plage PUA
# U+E000 à U+E024 (37 glyphes)

# Emoji: 🏐 -> U+E000 (alb)
NewGlyph()
Select(0xE000)
GlyphInfo("Unicode", 0xE000)
GlyphInfo("Name", "alb")

# Emoji: 🌱 -> U+E001 (co2)
Select(0xE001)
NewGlyph()
GlyphInfo("Unicode", 0xE001)
GlyphInfo("Name", "co2")

